#include <stdio.h>

// Estrutura para organizar os dados das cidades
typedef struct {
    char estado[3];
    char codigo[10];
    char nome[50];
    unsigned long int populacao;
    float area;
    double pib;
    int pontos_turisticos;
    float densidade;
    float pib_per_capita;
    float super_poder;
} Carta;

int main() {
    Carta c1, c2;

    // --- CADASTRO DA CARTA 1 ---
    printf("Cadastro da Carta 1:\n");
    printf("Estado (A-H): "); scanf("%s", c1.estado);
    printf("Código (ex: A01): "); scanf("%s", c1.codigo);
    printf("Nome da Cidade: "); scanf(" %[^\n]s", c1.nome);
    printf("População: "); scanf("%lu", &c1.populacao);
    printf("Área (km²): "); scanf("%f", &c1.area);
    printf("PIB (bilhões): "); scanf("%lf", &c1.pib);
    printf("Pontos Turísticos: "); scanf("%d", &c1.pontos_turisticos);

    // Cálculos Carta 1
    c1.densidade = (float)c1.populacao / c1.area;
    c1.pib_per_capita = (float)((c1.pib * 1000000000) / c1.populacao);
    // Super Poder: Soma de tudo + inverso da densidade (1/densidade)
    c1.super_poder = (float)c1.populacao + c1.area + (float)c1.pib + 
                     (float)c1.pontos_turisticos + c1.pib_per_capita + (1.0f / c1.densidade);

    printf("\n------------------------------\n");

    // --- CADASTRO DA CARTA 2 ---
    printf("Cadastro da Carta 2:\n");
    printf("Estado (A-H): "); scanf("%s", c2.estado);
    printf("Código: "); scanf("%s", c2.codigo);
    printf("Nome da Cidade: "); scanf(" %[^\n]s", c2.nome);
    printf("População: "); scanf("%lu", &c2.populacao);
    printf("Área (km²): "); scanf("%f", &c2.area);
    printf("PIB (bilhões): "); scanf("%lf", &c2.pib);
    printf("Pontos Turísticos: "); scanf("%d", &c2.pontos_turisticos);

    // Cálculos Carta 2
    c2.densidade = (float)c2.populacao / c2.area;
    c2.pib_per_capita = (float)((c2.pib * 1000000000) / c2.populacao);
    c2.super_poder = (float)c2.populacao + c2.area + (float)c2.pib + 
                     (float)c2.pontos_turisticos + c2.pib_per_capita + (1.0f / c2.densidade);

    // --- COMPARAÇÃO E RESULTADOS ---
    printf("\n====================================\n");
    printf("      RESULTADO DA COMPARAÇÃO       \n");
    printf("====================================\n");

    // Regra: Maior valor vence (1), exceto Densidade onde Menor vence (0 se C1 for maior)
    printf("População: Carta %d venceu (%d)\n", (c1.populacao > c2.populacao ? 1 : 2), (c1.populacao > c2.populacao));
    printf("Área: Carta %d venceu (%d)\n", (c1.area > c2.area ? 1 : 2), (c1.area > c2.area));
    printf("PIB: Carta %d venceu (%d)\n", (c1.pib > c2.pib ? 1 : 2), (c1.pib > c2.pib));
    printf("Pontos Turísticos: Carta %d venceu (%d)\n", (c1.pontos_turisticos > c2.pontos_turisticos ? 1 : 2), (c1.pontos_turisticos > c2.pontos_turisticos));
    
    // Lógica invertida para Densidade Populacional
    printf("Densidade Populacional: Carta %d venceu (%d)\n", (c1.densidade < c2.densidade ? 1 : 2), (c1.densidade < c2.densidade));
    
    printf("PIB per Capita: Carta %d venceu (%d)\n", (c1.pib_per_capita > c2.pib_per_capita ? 1 : 2), (c1.pib_per_capita > c2.pib_per_capita));
    printf("Super Poder: Carta %d venceu (%d)\n", (c1.super_poder > c2.super_poder ? 1 : 2), (c1.super_poder > c2.super_poder));
    
    printf("====================================\n");

    return 0;
}
