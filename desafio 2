#include <stdio.h>

// Definição da estrutura para organizar os dados da cidade
typedef struct {
    char estado[3];
    char codigo[10];
    char nome[50];
    unsigned long int populacao;
    float area;
    double pib;
    int pontos_turisticos;
    float densidade_populacional;
    float pib_per_capita;
} Cidade;

int main() {
    Cidade c;

    printf("--- Cadastro de Cartas: Super Trunfo Países ---\n");

    // Entrada de Dados
    printf("Digite a letra do Estado (ex: A, B): ");
    scanf("%s", c.estado);

    printf("Digite o código da carta (ex: A01, B02): ");
    scanf("%s", c.codigo);

    printf("Digite o nome da cidade: ");
    scanf(" %[^\n]s", c.nome); // Lê a string incluindo espaços

    printf("População: ");
    scanf("%lu", &c.populacao);

    printf("Área (em km²): ");
    scanf("%f", &c.area);

    printf("PIB (em bilhões de reais): ");
    scanf("%lf", &c.pib);

    printf("Número de pontos turísticos: ");
    scanf("%d", &c.pontos_turisticos);

    // Cálculos de Propriedades Derivadas
    // Densidade = População / Área
    c.densidade_populacional = (float)c.populacao / c.area;

    // PIB per capita = PIB total / População
    // Nota: Multiplicamos o PIB por 1.000.000.000 se o input for em bilhões
    c.pib_per_capita = (c.pib * 1000000000) / c.populacao;

    // Exibição dos Resultados
    printf("\n====================================\n");
    printf("       DADOS DA CARTA REGISTRADA     \n");
    printf("====================================\n");
    printf("Estado: %s\n", c.estado);
    printf("Código: %s\n", c.codigo);
    printf("Nome da Cidade: %s\n", c.nome);
    printf("População: %lu\n", c.populacao);
    printf("Área: %.2f km²\n", c.area);
    printf("PIB: R$ %.2lf bilhões\n", c.pib);
    printf("Pontos Turísticos: %d\n", c.pontos_turisticos);
    
    printf("\n--- PROPRIEDADES CALCULADAS ---\n");
    printf("Densidade Populacional: %.2f hab/km²\n", c.densidade_populacional);
    printf("PIB per Capita: R$ %.2f\n", c.pib_per_capita);
    printf("====================================\n");

    return 0;
}
