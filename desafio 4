#include <stdio.h>

// Definição de constantes para facilitar o ajuste do movimento
#define MOV_TORRE 5
#define MOV_BISPO 4
#define MOV_RAINHA 8

// --- FUNÇÕES RECURSIVAS ---

// Função recursiva para o movimento da Torre (Direita)
void moverTorre(int casas) {
    if (casas > 0) {
        printf("Direita\n");
        moverTorre(casas - 1); // Chamada recursiva diminuindo o contador
    }
}

// Função recursiva para o movimento da Rainha (Esquerda)
void moverRainha(int casas) {
    if (casas > 0) {
        printf("Esquerda\n");
        moverRainha(casas - 1);
    }
}

// Função recursiva para o Bispo (Diagonal Superior Direita)
// O Bispo usa recursão para controlar a repetição, mas o desafio pede aninhamento interno
void moverBispoRecursivo(int casas) {
    if (casas > 0) {
        // Loops aninhados para representar a natureza bidimensional da diagonal
        // O loop externo representa o eixo vertical (Cima)
        for (int i = 1; i <= 1; i++) {
            // O loop interno representa o eixo horizontal (Direita)
            for (int j = 1; j <= 1; j++) {
                printf("Cima, ");
            }
            printf("Direita\n");
        }
        moverBispoRecursivo(casas - 1);
    }
}

int main() {
    // --- MOVIMENTAÇÃO DA TORRE ---
    printf("Movimento da Torre:\n");
    moverTorre(MOV_TORRE);
    printf("\n");

    // --- MOVIMENTAÇÃO DO BISPO ---
    // Implementação utilizando recursividade e loops aninhados
    printf("Movimento do Bispo:\n");
    moverBispoRecursivo(MOV_BISPO);
    printf("\n");

    // --- MOVIMENTAÇÃO DA RAINHA ---
    printf("Movimento da Rainha:\n");
    moverRainha(MOV_RAINHA);
    printf("\n");

    // --- MOVIMENTAÇÃO DO CAVALO ---
    // Movimento em "L": 2 casas para Cima e 1 para a Direita
    // Utilizando loops aninhados com múltiplas variáveis e condições de controle
    printf("Movimento do Cavalo:\n");
    
    // O loop externo simula as duas casas para cima
    for (int i = 0, casasCima = 2; i < 1; i++) {
        while (casasCima > 0) {
            printf("Cima\n");
            casasCima--;
            
            // Condição complexa: quando terminar o movimento vertical, executa o horizontal
            if (casasCima == 0) {
                for (int j = 0; j < 1; j++) {
                    printf("Direita\n");
                    break; // Interrompe o loop interno após o movimento
                }
            }
        }
    }

    return 0;
}
